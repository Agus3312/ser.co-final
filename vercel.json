{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && mv dist/index.html dist/v1.html && mv dist/index-v2.html dist/index.html",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/index-v2", "destination": "/" },
    { "source": "/index-v2.html", "destination": "/" }
  ]
}
